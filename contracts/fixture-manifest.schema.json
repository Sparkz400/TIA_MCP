{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tia-mcp:fixture-manifest:v1",
  "type": "object",
  "required": ["schemaVersion", "fixtureId", "title", "featureIds", "profile", "steps", "expectedBehavior", "coverage"],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixtureId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "title": {"type": "string", "minLength": 1},
    "featureIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "profile": {
      "type": "object", "required": ["tiaVersion", "cpuFamilies", "languages", "requires"],
      "properties": {"tiaVersion": {"const": 21}, "cpuFamilies": {"type": "array", "items": {"type": "string"}}, "languages": {"type": "array", "items": {"type": "string"}}, "requires": {"type": "array", "items": {"type": "string"}}}
    },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["stepId", "tool", "arguments", "expect"], "properties": {"stepId": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}, "arguments": {"type": "object"}, "expect": {"type": "object"}}}
    },
    "expectedBehavior": {"type": "object"},
    "coverage": {"type": "object"}
  }
}
