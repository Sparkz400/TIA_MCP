{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tia-mcp:library-plan:v1",
  "title": "Prepared library preview observation envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "sessionGeneration",
    "resources",
    "selection",
    "dependencies",
    "effects",
    "warnings",
    "payload",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "library_create",
        "library_upgrade",
        "library_copy_elements",
        "library_instantiate",
        "library_update_project",
        "library_integrate",
        "library_create_type",
        "library_create_master_copy",
        "library_edit_version",
        "library_release_version",
        "library_discard_version",
        "library_set_default",
        "library_type_policy",
        "library_organize",
        "library_delete",
        "library_publish",
        "library_save",
        "library_archive",
        "library_cleanup",
        "library_harmonize"
      ]
    },
    "sessionGeneration": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "urn:tia-mcp:library-lock:v1#/$defs/source"
      },
      "maxItems": 32
    },
    "selection": {
      "type": "array",
      "items": {
        "$ref": "urn:tia-mcp:library-lock:v1#/$defs/selection"
      },
      "maxItems": 100
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "urn:tia-mcp:library-lock:v1#/$defs/dependency"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "componentContentPins": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
      }
    },
    "projectPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "unsavedTargetEdits": {
      "type": "object",
      "properties": {
        "present": {"type": "boolean"},
        "disposition": {"enum": ["none", "savedIntoCheckpointBaseline"]}
      },
      "required": ["present", "disposition"],
      "additionalProperties": false
    },
    "outputAbsent": {
      "type": "string",
      "minLength": 1
    },
    "upgradeSourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "upgradeSourceHashScope": {
      "type": "string",
      "minLength": 1
    },
    "typeSynchronization": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
      }
    },
    "targetPreview": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "updateImpact": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "updateBaseline": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "updateCleanupGuard": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "documentsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "documentSource": {
      "type": "object",
      "required": [
        "originalDirectory",
        "snapshotDirectory",
        "sha256",
        "hashScope",
        "ownedSnapshot"
      ],
      "properties": {
        "originalDirectory": {
          "type": "string",
          "minLength": 1
        },
        "snapshotDirectory": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "hashScope": {
          "type": "string",
          "minLength": 1
        },
        "ownedSnapshot": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "sourceObject": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "existingRecoveryCheckpoint": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "targetScope": {
      "type": "string",
      "minLength": 1
    },
    "compileTarget": {
      "type": "string",
      "minLength": 1
    },
    "compileScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compileTargetPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrationPlan": {
      "type": "object",
      "description": "Retained operation-specific observation; native meaning is outside this envelope contract."
    },
    "versionFromDocuments": {
      "type": "object",
      "required": ["typeGuid", "baseVersionGuid", "createOptions", "scope"],
      "properties": {
        "typeGuid": {"type": "string", "minLength": 36, "maxLength": 36},
        "baseVersionGuid": {"type": "string", "minLength": 36, "maxLength": 36},
        "createOptions": {"const": "None"},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reusedDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["typeName", "typeGuid", "versionGuid", "version", "object", "comparedProperties", "properties", "proof"],
        "properties": {
          "typeName": {"type": "string", "minLength": 1},
          "typeGuid": {"type": "string", "minLength": 36, "maxLength": 36},
          "versionGuid": {"type": "string", "minLength": 36, "maxLength": 36},
          "version": {"type": "string", "minLength": 1},
          "object": {"type": "object"},
          "comparedProperties": {"type": "integer", "minimum": 1},
          "properties": {"type": "array", "items": {"type": "object"}},
          "proof": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "description": "Installed exact dependencies reused instead of instantiated; each carries its native identity and metadata comparison."
    },
    "createdNames": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "instanceNamespace": {
      "type": "object",
      "required": ["namespace", "unitNamespacePreset", "objects", "scope"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$", "maxLength": 128},
        "unitNamespacePreset": {"type": ["string", "null"]},
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["typeName", "typeNamespace"],
            "properties": {"typeName": {"type": "string", "minLength": 1}, "typeNamespace": {"type": "string"}},
            "additionalProperties": false
          }
        },
        "scope": {"type": "string"}
      },
      "additionalProperties": false
    },
    "targetNamesBefore": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "applySupported": {
      "const": false
    },
    "applyError": {
      "type": "string",
      "minLength": 1
    },
    "cleanup": {
      "type": "object",
      "description": "library_cleanup: the maximum deletion set and the versions kept, with the reason for each.",
      "required": ["cleanUpMode", "projectPath", "deleteVersions", "deleteTypes", "retainedScopeVersions", "retainedLibraryVersions", "policy"],
      "properties": {
        "cleanUpMode": {"enum": ["PreserveDefaultVersionOfUnusedTypes", "DeleteUnusedTypes"]},
        "projectPath": {"type": ["string", "null"]},
        "deleteVersions": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
          "type": "object",
          "required": ["typeGuid", "versionGuid", "typeName", "version", "state", "isDefault"],
          "properties": {"typeGuid": {"type": "string", "minLength": 36, "maxLength": 36}, "versionGuid": {"type": "string", "minLength": 36, "maxLength": 36}}
        }},
        "deleteTypes": {"type": "array", "maxItems": 100, "items": {
          "type": "object",
          "required": ["typeGuid", "typeName"],
          "properties": {"typeGuid": {"type": "string", "minLength": 36, "maxLength": 36}, "typeName": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }},
        "retainedScopeVersions": {"type": "array", "maxItems": 1000, "items": {
          "type": "object",
          "required": ["typeGuid", "versionGuid", "typeName", "version", "state", "isDefault", "reason"],
          "properties": {"reason": {"enum": ["embeddedInMasterCopy", "usedInProject", "dependencyOfRetainedVersion", "preservedDefaultOrHighest"]}}
        }},
        "retainedLibraryVersions": {
          "type": "object",
          "required": ["count", "sha256"],
          "properties": {"count": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}},
          "additionalProperties": false
        },
        "policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "harmonize": {
      "type": "object",
      "description": "library_harmonize: each affected instance's current and expected name and group path.",
      "required": ["plcPath", "harmonizeNames", "harmonizePaths", "instances", "unaffectedObjects", "pathMapping"],
      "properties": {
        "plcPath": {"type": "string", "minLength": 1},
        "harmonizeNames": {"type": "boolean"},
        "harmonizePaths": {"type": "boolean"},
        "instances": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
          "type": "object",
          "required": ["objectPath", "scopePath", "typeGuid", "versionGuid", "name", "expectedName", "groupPath", "expectedGroupPath", "changes"],
          "properties": {
            "objectPath": {"type": "string", "minLength": 1},
            "scopePath": {"type": "string", "minLength": 1},
            "typeGuid": {"type": "string", "minLength": 36, "maxLength": 36},
            "versionGuid": {"type": "string", "minLength": 36, "maxLength": 36},
            "name": {"type": "string", "minLength": 1},
            "expectedName": {"type": "string", "minLength": 1},
            "groupPath": {"type": "string"},
            "expectedGroupPath": {"type": "string"},
            "changes": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["name", "path"]}}
          },
          "additionalProperties": false
        }},
        "unaffectedObjects": {
          "type": "object",
          "required": ["count", "sha256"],
          "properties": {"count": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}},
          "additionalProperties": false
        },
        "pathMapping": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Prepared library preview envelope and exact metadata pins. Payload, effects and operation-specific analysis remain opaque; validation grants no apply or native qualification authority.",
  "dependentRequired": {
    "documentsHash": [
      "documentSource"
    ],
    "documentSource": [
      "documentsHash"
    ],
    "compileTargetPaths": [
      "compileScope"
    ],
    "integrationPlan": [
      "applySupported",
      "applyError"
    ],
    "applySupported": [
      "integrationPlan",
      "applyError"
    ],
    "upgradeSourceHash": [
      "upgradeSourceHashScope"
    ],
    "upgradeSourceHashScope": [
      "upgradeSourceHash"
    ]
  }
}
