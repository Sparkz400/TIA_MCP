{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/testsuite-scope-coverage.v1.schema.json",
  "title": "Requested versus independently observed Test Suite scope; no native or release authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["planSha256", "entries", "requiredScopePassed", "nativeExecutedByComparer", "releaseAccepted"],
  "properties": {
    "planSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/entry"}},
    "requiredScopePassed": {"type": "boolean"},
    "nativeExecutedByComparer": {"const": false},
    "releaseAccepted": {"const": false}
  },
  "$defs": {
    "scope": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "engineering-object-reference.v1.schema.json"}
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "status", "requiredScope", "effectiveScope", "missingScope", "unexpectedScope", "ignoredScope", "observationComplete"],
      "properties": {
        "definitionId": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"enum": ["covered", "mismatch", "incomplete", "notObserved", "excluded"]},
        "requiredScope": {"allOf": [{"$ref": "#/$defs/scope"}, {"minItems": 1}]},
        "effectiveScope": {"$ref": "#/$defs/scope"},
        "missingScope": {"$ref": "#/$defs/scope"},
        "unexpectedScope": {"$ref": "#/$defs/scope"},
        "ignoredScope": {"$ref": "#/$defs/scope"},
        "observationComplete": {"type": "boolean"}
      }
    }
  }
}
