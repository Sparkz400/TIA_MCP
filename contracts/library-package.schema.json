{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tia-mcp:library-package:v1",
  "title": "Immutable library package manifest; classification is not native qualification",
  "type": "object",
  "required": ["schemaVersion", "packageId", "state", "createdUtc", "host", "sourceKind", "sourceLabel", "sourceSha256", "inputBytes", "expandedBytes", "limits", "files", "candidates", "documents", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": 1},
    "packageId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "state": {"const": "ready"},
    "createdUtc": {"type": "string", "format": "date-time"},
    "host": {"type": "string", "minLength": 1},
    "sourceKind": {"type": "string"},
    "sourceLabel": {"type": "string"},
    "sourceUrl": {"type": ["string", "null"], "description": "Provenance supplied by the caller; never fetched or treated as proof of authenticity."},
    "sourceSha256": {"$ref": "#/$defs/sha256"},
    "inputBytes": {"type": "integer", "minimum": 0},
    "expandedBytes": {"type": "integer", "minimum": 0},
    "limits": {"type": "object", "description": "Effective server limits; package content cannot override them."},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "documents": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object", "required": ["relativePath", "bytes", "sha256", "role"],
      "properties": {"relativePath": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "role": {"type": "string"}}
    },
    "candidate": {
      "type": "object", "required": ["candidateId", "relativePath", "kind", "tiaMajorVersion", "readyForNativeInspection", "completeness", "notes"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/sha256"},
        "relativePath": {"type": "string", "minLength": 1},
        "kind": {"enum": ["globalLibraryArchive", "globalLibraryDirectory", "exampleProjectArchive", "exampleProjectDirectory", "sourceFile"]},
        "tiaMajorVersion": {"type": ["integer", "null"]},
        "readyForNativeInspection": {"type": "boolean", "description": "Candidate eligibility for native inspection, never a validity/importability claim."},
        "completeness": {"enum": ["nativeVerificationRequired", "missingCompanionFiles", "sourceImportRequired"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
