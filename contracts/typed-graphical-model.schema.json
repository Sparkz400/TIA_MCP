{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tia-mcp:typed-graphical-model:v1",
  "title": "Version 1 typed LAD power flow or FBD dataflow change",
  "description": "Passed as the typed model to change_prepare. Native target identities and profiles are resolved by the worker; callers cannot supply trusted resolution or qualification evidence. Schema acceptance is not instruction or target qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "language", "operation", "nodes", "connections", "operands"],
  "properties": {
    "schemaVersion": {"const": 1},
    "language": {"enum": ["LAD", "FBD"]},
    "operation": {"enum": ["insertNetwork", "replaceNetwork", "editNetwork", "createBlock"]},
    "networkId": {"$ref": "#/$defs/nativeId"},
    "insertAfterNetworkId": {"$ref": "#/$defs/nativeId"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/node"}},
    "connections": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/connection"}},
    "operands": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/operand"}},
    "creation": {"$ref": "#/$defs/creation"}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"enum": ["insertNetwork", "createBlock"]}}}, "then": {"properties": {"nodes": {"items": {"not": {"required": ["nativeUid"]}}}}}},
    {"if": {"properties": {"operation": {"const": "editNetwork"}}}, "then": {"properties": {"connections": {"maxItems": 0}, "nodes": {"items": {"required": ["nativeUid"], "properties": {"kind": {"enum": ["contact", "coil", "assign"]}}, "not": {"anyOf": [{"required": ["negated"]}, {"required": ["inputCount"]}, {"required": ["dataType"]}, {"required": ["comparison"]}, {"required": ["instruction"]}, {"required": ["calleePath"]}, {"required": ["instance"]}, {"required": ["allowSharedInstance"]}]}}}}}},
    {"if": {"properties": {"operation": {"enum": ["replaceNetwork", "editNetwork"]}}}, "then": {"required": ["networkId"], "not": {"anyOf": [{"required": ["creation"]}, {"required": ["insertAfterNetworkId"]}]}}, "else": {"not": {"required": ["networkId"]}}},
    {"if": {"properties": {"operation": {"const": "createBlock"}}}, "then": {"required": ["creation"], "not": {"required": ["insertAfterNetworkId"]}}, "else": {"not": {"required": ["creation"]}}},
    {"if": {"properties": {"language": {"const": "LAD"}}}, "then": {"properties": {"nodes": {"items": {"properties": {"kind": {"enum": ["powerrail", "contact", "coil", "branch", "compare", "call", "timer", "counter", "move", "math", "edge"]}}}}}}, "else": {"properties": {"nodes": {"items": {"properties": {"kind": {"enum": ["and", "or", "not", "assign", "compare", "call", "timer", "counter", "move", "math", "edge"]}}}}}}}
  ],
  "$defs": {
    "key": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"},
    "nativeId": {"type": "string", "pattern": "^[0-9A-Fa-f]+(?![\\s\\S])", "maxLength": 10},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "type": {"type": "string", "minLength": 1, "maxLength": 256},
    "node": {
      "type": "object", "additionalProperties": false, "required": ["key", "kind"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "kind": {"enum": ["powerrail", "contact", "coil", "branch", "and", "or", "not", "assign", "compare", "call", "timer", "counter", "move", "math", "edge"]},
        "operand": {"$ref": "#/$defs/key"},
        "inputCount": {"type": "integer", "minimum": 0, "maximum": 32},
        "comparison": {"enum": ["eq", "ne", "lt", "le", "gt", "ge"]},
        "dataType": {"$ref": "#/$defs/type"},
        "calleePath": {"$ref": "#/$defs/path"},
        "instance": {"$ref": "#/$defs/key"},
        "instruction": {"enum": ["TON", "TOF", "TP", "TONR", "CTU", "CTD", "CTUD", "ADD", "SUB", "MUL", "DIV", "R_TRIG", "F_TRIG"]},
        "nativeUid": {"type": "string", "pattern": "^[0-9]+(?![\\s\\S])", "maxLength": 10},
        "negated": {"type": "boolean"},
        "allowSharedInstance": {"type": "boolean", "default": false}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["contact", "coil", "assign"]}}}, "then": {"required": ["operand"]}},
        {"if": {"properties": {"kind": {"const": "compare"}}}, "then": {"required": ["comparison", "dataType"]}},
        {"if": {"properties": {"kind": {"const": "call"}}}, "then": {"required": ["calleePath"]}},
        {"if": {"properties": {"kind": {"enum": ["timer", "counter", "edge"]}}}, "then": {"required": ["instruction", "instance"]}},
        {"if": {"properties": {"kind": {"enum": ["move", "math"]}}}, "then": {"required": ["dataType"]}},
        {"if": {"properties": {"kind": {"const": "math"}}}, "then": {"required": ["instruction"], "properties": {"instruction": {"enum": ["ADD", "SUB", "MUL", "DIV"]}}}},
        {"if": {"properties": {"kind": {"const": "edge"}}}, "then": {"properties": {"instruction": {"enum": ["R_TRIG", "F_TRIG"]}}}},
        {"if": {"properties": {"kind": {"const": "timer"}}}, "then": {"properties": {"instruction": {"enum": ["TON", "TOF", "TP", "TONR"]}}}},
        {"if": {"properties": {"kind": {"const": "counter"}}}, "then": {"properties": {"instruction": {"enum": ["CTU", "CTD", "CTUD"]}}}}
      ]
    },
    "operand": {
      "type": "object", "additionalProperties": false, "required": ["key", "scope"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "scope": {"enum": ["local", "tag", "db", "constant"]},
        "ownerPath": {"$ref": "#/$defs/path"},
        "components": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "dataType": {"$ref": "#/$defs/type"},
        "value": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "constant"}}}, "then": {"required": ["dataType", "value"], "not": {"anyOf": [{"required": ["components"]}, {"required": ["ownerPath"]}]}}, "else": {"required": ["components"], "not": {"required": ["value"]}}},
        {"if": {"properties": {"scope": {"enum": ["tag", "db"]}}}, "then": {"required": ["ownerPath"]}}
      ]
    },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["node", "port"],
      "properties": {
        "node": {"type": "string", "pattern": "^\\$?[A-Za-z_][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"},
        "port": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "connection": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/endpoint"}, "to": {"$ref": "#/$defs/endpoint"}}},
    "creation": {
      "type": "object", "additionalProperties": false, "required": ["name", "blockType", "interface"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}(?![\\s\\S])"}, "blockType": {"enum": ["FC", "FB"]},
        "interface": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/declaration"}}
      }
    },
    "declaration": {
      "type": "object", "additionalProperties": false, "required": ["name", "section", "dataType"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}(?![\\s\\S])"},
        "section": {"enum": ["Input", "Output", "InOut", "Temp", "Static", "Constant", "Return"]}, "dataType": {"$ref": "#/$defs/type"}
      }
    }
  }
}
