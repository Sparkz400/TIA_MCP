{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/api-coverage-bindings.v1.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "scannerVersion",
    "nativeExecuted",
    "releaseAccepted",
    "scope",
    "counts",
    "sourceInputs",
    "tools",
    "mutations",
    "features",
    "evidenceInputs",
    "evidenceProfiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "api-coverage-bindings.v1"
    },
    "scannerVersion": {
      "const": 1
    },
    "nativeExecuted": {
      "const": false
    },
    "releaseAccepted": {
      "const": false
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "required": [
        "tools",
        "mutations",
        "features"
      ],
      "properties": {
        "tools": {
          "type": "integer",
          "minimum": 0
        },
        "mutations": {
          "type": "integer",
          "minimum": 0
        },
        "features": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sourceInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "host",
          "bridgeOperations",
          "localCallNames",
          "workerRoutes",
          "localHandlers",
          "hostDelegationAnchors",
          "reviewState",
          "gaps"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "object",
            "required": [
              "path",
              "name",
              "line",
              "endLine",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "bridgeOperations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "localCallNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "workerRoutes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "operation",
                "handlers",
                "reviewState",
                "gaps"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "dispatcher": {
                  "type": "object",
                  "required": [
                    "path",
                    "name",
                    "line",
                    "endLine",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                },
                "handlers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "name",
                      "line",
                      "endLine",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "endLine": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "reviewState": {
                  "enum": [
                    "static_dispatch_bound",
                    "unresolved"
                  ]
                },
                "gaps": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "localHandlers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "name",
                "line",
                "endLine",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "hostDelegationAnchors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "name",
                "line",
                "endLine",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "reviewState": {
            "const": "static_entrypoint_bound"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "changeKind",
          "featureId",
          "dispatcherFamily",
          "branches",
          "reviewState",
          "gaps"
        ],
        "properties": {
          "changeKind": {
            "type": "string",
            "minLength": 1
          },
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "dispatcherFamily": {
            "enum": [
              "library_delegation",
              "engineering"
            ]
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "phase",
                "routeKind",
                "anchor",
                "handlers"
              ],
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "routeKind": {
                  "enum": [
                    "direct_early_route",
                    "switch_case"
                  ]
                },
                "anchor": {
                  "type": "object",
                  "required": [
                    "path",
                    "name",
                    "line",
                    "endLine",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                },
                "handlers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "name",
                      "line",
                      "endLine",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "endLine": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "reviewState": {
            "enum": [
              "static_branches_bound",
              "partial"
            ]
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "featureId",
          "tools",
          "changeKind",
          "sourceDependencies",
          "schemaBindings",
          "schemaReview",
          "evidenceRefs",
          "reviewState",
          "gaps",
          "releaseAccepted",
          "qualificationPromoted"
        ],
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "changeKind": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceDependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "schemaBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "source",
                "sourceAnchor",
                "literal",
                "reviewState",
                "conformanceProven"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceAnchor": {
                  "type": "object",
                  "required": [
                    "path",
                    "name",
                    "line",
                    "endLine",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                },
                "literal": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewState": {
                  "const": "literal_contract_reference"
                },
                "conformanceProven": {
                  "const": false
                }
              },
              "additionalProperties": false
            }
          },
          "schemaReview": {
            "enum": [
              "partial",
              "unresolved"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "profileSha256",
                "artifacts"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "profileSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "reviewState": {
            "const": "partial"
          },
          "gaps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "releaseAccepted": {
            "const": false
          },
          "qualificationPromoted": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "state",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "observed",
              "unavailable_bounded_read",
              "directory",
              "missing"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "profileSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profileSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
