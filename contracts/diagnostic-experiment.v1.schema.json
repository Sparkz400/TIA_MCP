{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/diagnostic-experiment.v1.schema.json",
  "title": "Retained offline diagnostic experiment composition",
  "type": "object",
  "required": ["schemaVersion", "diagnosticPlanId", "reviewId", "request", "diagnosticCase", "watchPlanId", "tracePlanId", "tests", "compositionGaps", "sourceAuthenticityVerified", "nativeExecutable", "nativeAccessAttempted", "qualification", "limits"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "diagnostic-experiment.v1"},
    "diagnosticPlanId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
    "reviewId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
    "request": {"$ref": "#/$defs/request"},
    "diagnosticCase": {"$ref": "diagnostic-case.v1.schema.json"},
    "watchPlanId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
    "tracePlanId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
    "tests": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["hypothesisId", "statement", "prediction", "assessment", "signals"],
        "properties": {
          "hypothesisId": {"type": "string", "minLength": 1, "maxLength": 64},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "prediction": {"type": ["object", "null"]},
          "assessment": {"enum": ["unresolvedWithoutPrediction", "samplePredictionOnly"]},
          "signals": {
            "type": "array", "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "role", "reason"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 64},
                "role": {"type": "string", "minLength": 1, "maxLength": 64},
                "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
              }
            }
          }
        }
      }
    },
    "compositionGaps": {"type": "array", "maxItems": 15, "items": {"type": "string"}},
    "sourceAuthenticityVerified": {"const": false},
    "nativeExecutable": {"const": false},
    "nativeAccessAttempted": {"const": false},
    "qualification": {"const": "offlineExperimentOnly"},
    "limits": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false, "required": ["reason", "watch", "trace"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "watch": {"$ref": "diagnostic-watch-plan.v1.schema.json#/$defs/request"},
        "trace": {"$ref": "trace-plan.v1.schema.json#/$defs/request"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["planId", "request"],
      "properties": {
        "planId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
        "request": {"$ref": "#/$defs/request"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false, "required": ["id", "artifact", "schemaVersion", "experiment"],
      "properties": {
        "id": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "schemaVersion": {"const": "diagnostic-experiment.v1"},
        "experiment": {"$ref": "#"}
      }
    }
  }
}
