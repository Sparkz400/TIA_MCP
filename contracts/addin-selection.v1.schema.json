{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/addin-selection.v1.schema.json",
  "title": "Detached Add-In selection evidence; no native authority",
  "$ref": "#/$defs/request",
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "version",
        "tiaVersion",
        "assemblySha256",
        "configurationSha256"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "tiaVersion": {
          "const": 21
        },
        "assemblySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "snapshotId",
        "sessionGeneration",
        "projectPath",
        "nodeId",
        "objectPath"
      ],
      "properties": {
        "schemaVersion": {
          "const": "project-model.v1"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "sessionGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "objectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewId",
        "selectionId",
        "selectedAtUtc",
        "surface",
        "projectHost",
        "producer",
        "references"
      ],
      "properties": {
        "schemaVersion": {
          "const": "addin-selection.v1"
        },
        "reviewId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selectionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "selectedAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{7}(Z|\\+00:00)$"
        },
        "surface": {
          "enum": [
            "projectTree",
            "devicesAndNetworks"
          ]
        },
        "projectHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "kind",
        "name",
        "binding",
        "contentVerified",
        "liveSelectionVerified"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "binding": {
          "const": "exactSavedReference"
        },
        "contentVerified": {
          "const": false
        },
        "liveSelectionVerified": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectionCount",
        "scope",
        "sourceEvidencePolicy"
      ],
      "properties": {
        "selectionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "scope": {
          "const": "savedReviewOnly"
        },
        "sourceEvidencePolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewId",
        "selectionId",
        "selectedAtUtc",
        "surface",
        "projectHost",
        "producer",
        "selections",
        "producerAuthenticated",
        "liveSelectionVerified",
        "nativeExecutable",
        "nativeQualified",
        "summary"
      ],
      "properties": {
        "schemaVersion": {
          "const": "addin-selection-report.v1"
        },
        "reviewId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selectionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "selectedAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{7}(Z|\\+00:00)$"
        },
        "surface": {
          "enum": [
            "projectTree",
            "devicesAndNetworks"
          ]
        },
        "projectHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/selection"
          }
        },
        "producerAuthenticated": {
          "const": false
        },
        "liveSelectionVerified": {
          "const": false
        },
        "nativeExecutable": {
          "const": false
        },
        "nativeQualified": {
          "const": false
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^addin-selections/[a-f0-9]{64}\\.(input|json)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewId",
        "input",
        "report"
      ],
      "properties": {
        "schemaVersion": {
          "const": "addin-selection-record.v1"
        },
        "reviewId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "$ref": "#/$defs/artifact"
        },
        "report": {
          "$ref": "#/$defs/report"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "reviewId",
        "input",
        "reportArtifact",
        "summary",
        "nativeExecutable",
        "nativeQualified",
        "sourceAuthenticityVerified",
        "liveFreshnessVerified",
        "producerAuthenticated",
        "liveSelectionVerified",
        "sourceEvidencePolicy"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "$ref": "#/$defs/artifact"
        },
        "reportArtifact": {
          "$ref": "#/$defs/artifact"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "nativeExecutable": {
          "const": false
        },
        "nativeQualified": {
          "const": false
        },
        "sourceAuthenticityVerified": {
          "const": false
        },
        "liveFreshnessVerified": {
          "const": false
        },
        "producerAuthenticated": {
          "const": false
        },
        "liveSelectionVerified": {
          "const": false
        },
        "sourceEvidencePolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "reviewId",
        "input",
        "reportArtifact",
        "summary",
        "nativeExecutable",
        "nativeQualified",
        "sourceAuthenticityVerified",
        "liveFreshnessVerified",
        "producerAuthenticated",
        "liveSelectionVerified",
        "sourceEvidencePolicy",
        "section",
        "offset",
        "total",
        "rows",
        "nextOffset"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "$ref": "#/$defs/artifact"
        },
        "reportArtifact": {
          "$ref": "#/$defs/artifact"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "nativeExecutable": {
          "const": false
        },
        "nativeQualified": {
          "const": false
        },
        "sourceAuthenticityVerified": {
          "const": false
        },
        "liveFreshnessVerified": {
          "const": false
        },
        "producerAuthenticated": {
          "const": false
        },
        "liveSelectionVerified": {
          "const": false
        },
        "sourceEvidencePolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "section": {
          "const": "selections"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "value"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value": {
                    "$ref": "#/$defs/selection"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "omitted",
                  "reason"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "omitted": {
                    "const": true
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
                  }
                }
              }
            ]
          }
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
