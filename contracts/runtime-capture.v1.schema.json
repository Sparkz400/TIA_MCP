{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/runtime-capture.v1.schema.json",
  "title": "Bounded polling capture with exact JSON strings and explicit quality limits",
  "oneOf": [
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/export"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "selectionIds",
        "intervalMilliseconds",
        "durationSeconds",
        "maximumSamples",
        "maximumBytes",
        "reviewId",
        "representation"
      ],
      "properties": {
        "attemptId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/id"
        },
        "selectionIds": {
          "type": "array",
          "items": {
            "$ref": "physical-runtime.v1.schema.json#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "intervalMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maximumSamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 67108864
        },
        "reviewId": {
          "anyOf": [
            {
              "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "representation": {
          "enum": [
            "simple",
            "raw"
          ]
        },
        "association": {
          "$ref": "#/$defs/associationRequest"
        },
        "handoffRef": {
          "type": "string",
          "pattern": "^runtime-handoff:[0-9a-f]{32}:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "association"
            ]
          },
          "then": {
            "properties": {
              "reviewId": {
                "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "handoffRef"
            ]
          },
          "then": {
            "properties": {
              "reviewId": {
                "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureId",
        "hostId",
        "createdUtc",
        "request",
        "signals"
      ],
      "properties": {
        "captureId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/id"
        },
        "hostId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/id"
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selectionId",
              "selection",
              "metadata"
            ],
            "properties": {
              "selectionId": {
                "$ref": "physical-runtime.v1.schema.json#/$defs/id"
              },
              "selection": {
                "$ref": "physical-runtime.v1.schema.json#/$defs/selection"
              },
              "metadata": {
                "type": "object"
              }
            }
          },
          "minItems": 1,
          "maxItems": 64
        },
        "association": {
          "$ref": "#/$defs/association"
        },
        "handoff": {
          "$ref": "#/$defs/handoff"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "request": {
                "required": [
                  "association"
                ]
              }
            }
          },
          "then": {
            "required": [
              "association"
            ]
          },
          "else": {
            "not": {
              "required": [
                "association"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "request": {
                "required": [
                  "handoffRef"
                ]
              }
            }
          },
          "then": {
            "required": [
              "handoff"
            ]
          },
          "else": {
            "not": {
              "required": [
                "handoff"
              ]
            }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "terminalReason",
        "elapsedMilliseconds",
        "observedUtc",
        "rows",
        "readAttempts",
        "skippedPolls",
        "droppedReadResults"
      ],
      "properties": {
        "state": {
          "enum": [
            "running",
            "ended"
          ]
        },
        "terminalReason": {
          "anyOf": [
            {
              "enum": [
                "durationLimit",
                "sampleLimit",
                "sessionUnavailable",
                "byteLimit",
                "valueLimit",
                "storageFailure",
                "stopped",
                "hostShutdown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsedMilliseconds": {
          "type": "number",
          "minimum": 0
        },
        "observedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "readAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "skippedPolls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36000
        },
        "droppedReadResults": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "kind",
        "selectionId",
        "cycle",
        "scheduledMilliseconds",
        "elapsedMilliseconds",
        "observedUtc",
        "readResultJson",
        "errorCode",
        "skippedPolls"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199999
        },
        "kind": {
          "enum": [
            "read",
            "gap"
          ]
        },
        "selectionId": {
          "anyOf": [
            {
              "$ref": "physical-runtime.v1.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36000
        },
        "scheduledMilliseconds": {
          "type": "number",
          "minimum": 0
        },
        "elapsedMilliseconds": {
          "type": "number",
          "minimum": 0
        },
        "observedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "readResultJson": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "enum": [
                "RuntimeTimeout",
                "RuntimeTransportFailure",
                "RuntimeCancelled",
                "RuntimePermissionDenied",
                "RuntimeSessionUnavailable",
                "RuntimeSessionExpired",
                "RuntimeSessionIdentityMismatch",
                "RuntimeSymbolMetadataChanged",
                "RuntimeRecordChanged",
                "RuntimeCaptureHandoffMismatch",
                "RuntimeCaptureHandoffUnavailable",
                "CredentialRetired",
                "RuntimeCaptureReadFailed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skippedPolls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gap"
              }
            }
          },
          "then": {
            "properties": {
              "selectionId": {
                "const": null
              },
              "readResultJson": {
                "const": null
              },
              "errorCode": {
                "const": null
              },
              "skippedPolls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 36000
              }
            }
          },
          "else": {
            "properties": {
              "selectionId": {
                "$ref": "physical-runtime.v1.schema.json#/$defs/id"
              },
              "skippedPolls": {
                "const": 0
              }
            },
            "oneOf": [
              {
                "properties": {
                  "readResultJson": {
                    "type": "string"
                  },
                  "errorCode": {
                    "const": null
                  }
                }
              },
              {
                "properties": {
                  "readResultJson": {
                    "const": null
                  },
                  "errorCode": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "omittedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "kind",
        "selectionId",
        "omitted",
        "reason"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199999
        },
        "kind": {
          "enum": [
            "read",
            "gap"
          ]
        },
        "selectionId": {
          "anyOf": [
            {
              "$ref": "physical-runtime.v1.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "omitted": {
          "const": true
        },
        "reason": {
          "const": "Row exceeds page budget; use exact capture export."
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "captureId",
        "snapshotRef",
        "state",
        "recordedProgress",
        "localFailure",
        "plan",
        "committedBytes",
        "uncommittedTailPresent",
        "uncommittedDataUnknown",
        "plcChangesBetweenPollsUnknown",
        "acquisitionMode",
        "atomicAcrossSignals",
        "scanSynchronized",
        "programMatchVerified",
        "nativeQualified"
      ],
      "properties": {
        "schemaVersion": {
          "const": "runtime-capture-status.v1"
        },
        "captureId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/id"
        },
        "snapshotRef": {
          "type": "string",
          "pattern": "^capture:[a-f0-9]{32}:(0|[1-9][0-9]{0,5}):[a-f0-9]{64}$",
          "maxLength": 112
        },
        "state": {
          "enum": [
            "running",
            "ended",
            "interrupted",
            "historicalPrefix"
          ]
        },
        "recordedProgress": {
          "$ref": "#/$defs/progress"
        },
        "localFailure": {
          "anyOf": [
            {
              "const": "RuntimeCaptureStorageFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "committedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "uncommittedTailPresent": {
          "type": "boolean"
        },
        "uncommittedDataUnknown": {
          "type": "boolean"
        },
        "plcChangesBetweenPollsUnknown": {
          "const": true
        },
        "acquisitionMode": {
          "const": "polling"
        },
        "atomicAcrossSignals": {
          "const": false
        },
        "scanSynchronized": {
          "const": false
        },
        "programMatchVerified": {
          "const": false
        },
        "nativeQualified": {
          "const": false
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "snapshotRef",
        "offset",
        "totalRows",
        "rows",
        "nextOffset",
        "nativeQualified"
      ],
      "properties": {
        "schemaVersion": {
          "const": "runtime-capture-page.v1"
        },
        "snapshotRef": {
          "type": "string",
          "pattern": "^capture:[a-f0-9]{32}:(0|[1-9][0-9]{0,5}):[a-f0-9]{64}$",
          "maxLength": 112
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "totalRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "rows": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/row"
              },
              {
                "$ref": "#/$defs/omittedRow"
              }
            ]
          },
          "minItems": 0,
          "maxItems": 200
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeQualified": {
          "const": false
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "capture",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "const": "runtime-capture-export.v1"
        },
        "capture": {
          "$ref": "#/$defs/status"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "minItems": 0,
          "maxItems": 200000
        }
      }
    },
    "associationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "mappings"
      ],
      "properties": {
        "caseId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selectionId",
              "signalId",
              "reason"
            ],
            "properties": {
              "selectionId": {
                "$ref": "physical-runtime.v1.schema.json#/$defs/id"
              },
              "signalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "assertedProgramIdentity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "reviewId",
        "project",
        "blockPath",
        "selectedInstance",
        "sourceRevision",
        "signals",
        "addressMatchVerified",
        "programMatchVerified",
        "sourceAuthenticityVerified",
        "nativeQualified"
      ],
      "properties": {
        "caseId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
        },
        "reviewId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
        },
        "project": {
          "type": "object"
        },
        "blockPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "selectedInstance": {
          "type": "object"
        },
        "sourceRevision": {
          "type": "object",
          "required": [
            "reviewId",
            "documents",
            "onlineVerified"
          ],
          "properties": {
            "reviewId": {
              "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
            },
            "documents": {
              "type": "array"
            },
            "onlineVerified": {
              "const": false
            }
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selectionId",
              "signalId",
              "declaration"
            ],
            "properties": {
              "selectionId": {
                "$ref": "physical-runtime.v1.schema.json#/$defs/id"
              },
              "signalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "declaration": {
                "allOf": [
                  {
                    "$ref": "diagnostic-signal-manifest.v1.schema.json#/items"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "resolution": {
                        "const": "capturedDeclaration"
                      },
                      "traceability": {
                        "const": "requiresTargetValidation"
                      },
                      "evidence": {
                        "type": "object",
                        "required": [
                          "liveVerified"
                        ],
                        "properties": {
                          "liveVerified": {
                            "const": false
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "addressMatchVerified": {
          "const": false
        },
        "programMatchVerified": {
          "const": false
        },
        "sourceAuthenticityVerified": {
          "const": false
        },
        "nativeQualified": {
          "const": false
        },
        "alarmBindings": {
          "$ref": "diagnostic-alarm-bindings.v1.schema.json",
          "properties": {
            "allSelectedMatched": {
              "const": true
            },
            "bindings": {
              "items": {
                "properties": {
                  "status": {
                    "const": "capturedDeclarationMatch"
                  }
                }
              }
            }
          }
        }
      }
    },
    "handoffSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "context",
        "subjectId",
        "securityMode",
        "credential",
        "peerVerified"
      ],
      "properties": {
        "hostId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/id"
        },
        "context": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/context"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "securityMode": {
          "enum": [
            "local",
            "static",
            "disabled",
            "umc"
          ]
        },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "vaultId",
            "credentialId",
            "bindingSha256",
            "cipherSha256"
          ],
          "properties": {
            "schemaVersion": {
              "const": "protected-credential-reference.v1"
            },
            "vaultId": {
              "$ref": "physical-runtime.v1.schema.json#/$defs/id"
            },
            "credentialId": {
              "$ref": "physical-runtime.v1.schema.json#/$defs/id"
            },
            "bindingSha256": {
              "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
            },
            "cipherSha256": {
              "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
            }
          }
        },
        "peerVerified": {
          "const": true
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordRef",
        "reviewId",
        "session",
        "declarationState",
        "deviceIdentityVerified",
        "programMatchVerified",
        "effectiveRightsVerified",
        "sourceAuthenticityVerified",
        "operationAdmitted",
        "assertionsAdmitted"
      ],
      "properties": {
        "schemaVersion": {
          "const": "runtime-capture-handoff.v1"
        },
        "recordRef": {
          "type": "string",
          "pattern": "^runtime-handoff:[0-9a-f]{32}:[0-9a-f]{64}$"
        },
        "reviewId": {
          "$ref": "physical-runtime.v1.schema.json#/$defs/sha256"
        },
        "session": {
          "$ref": "#/$defs/handoffSession"
        },
        "declarationState": {
          "const": "consistentDeclarations"
        },
        "deviceIdentityVerified": {
          "const": false
        },
        "programMatchVerified": {
          "const": false
        },
        "effectiveRightsVerified": {
          "const": false
        },
        "sourceAuthenticityVerified": {
          "const": false
        },
        "operationAdmitted": {
          "const": false
        },
        "assertionsAdmitted": {
          "const": false
        }
      }
    }
  }
}
