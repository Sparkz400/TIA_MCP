{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/hmi-engineering.v1.schema.json",
  "title": "Prepared HMI engineering payload",
  "description": "Payload of change_prepare kind hmi_engineering. All writes use existing change_apply/change_status/change_restore. Available native setters do not qualify a target; server-side exact-profile preservation and acceptance gates remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "target", "expectedContentHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"enum": ["scalar_property_set", "existing_binding_set", "tag_create", "item_properties_set", "item_place", "explicit_binding_set", "external_tag_create"]},
    "target": {"$ref": "hmi-identity.v2.schema.json"},
    "expectedContentHash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$", "description": "Complete native family-specific content hash; never an explorer metadata revision or partial export hash."},
    "properties": {"type": "object", "minProperties": 1, "maxProperties": 3, "additionalProperties": false, "properties": {
      "BackColor": {"type": "string", "minLength": 7, "maxLength": 13, "pattern": "^[0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}$"},
      "Enabled": {"type": "boolean"}, "Visible": {"type": "boolean"}, "TabIndex": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    }},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "dataType": {"enum": ["Bool", "Byte", "Word", "DWord", "LWord", "SInt", "USInt", "Int", "UInt", "DInt", "UDInt", "LInt", "ULInt", "Real", "LReal"]},
    "placement": {"type": "object", "additionalProperties": false, "required": ["left", "top", "width", "height"], "properties": {
      "left": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "top": {"type": "integer", "minimum": 0, "maximum": 2147483647},
      "width": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "height": {"type": "integer", "minimum": 1, "maximum": 4294967295}
    }},
    "connection": {"$ref": "hmi-identity.v2.schema.json", "description": "Exact Unified hmiConnection on the target HMI; its PLC owner is proven from native CommunicationManagement endpoints."},
    "plcTag": {"type": "object", "additionalProperties": false, "required": ["plcPath", "objectPath", "kind"], "properties": {
      "projectPath": {"type": "string", "minLength": 1}, "plcPath": {"type": "string", "minLength": 1}, "scopePath": {"type": "string", "minLength": 1},
      "objectPath": {"type": "string", "minLength": 1}, "kind": {"const": "tag"}, "name": {"type": "string", "minLength": 1}, "namespace": {"type": ["string", "null"]}
    }, "description": "Exact root PLC tag-table tag identity as returned by hmi_references; it must belong to the connection's native partner PLC."},
    "bindings": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "object", "additionalProperties": false,
      "required": ["property", "tagIdentity", "dataType"], "properties": {
        "property": {"type": "string", "minLength": 1, "maxLength": 256}, "tagIdentity": {"$ref": "hmi-identity.v2.schema.json"},
        "dataType": {"type": "string", "minLength": 1, "maxLength": 256}, "expectedValue": {"type": ["string", "number", "boolean", "null"]}
      }
    }}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "tag_create"}}}, "then": {"required": ["name", "dataType"], "properties": {"properties": false, "placement": false, "bindings": false, "connection": false, "plcTag": false}}},
    {"if": {"properties": {"operation": {"const": "external_tag_create"}}}, "then": {"required": ["name", "dataType", "connection", "plcTag"], "properties": {"properties": false, "placement": false, "bindings": false, "target": {"properties": {"family": {"const": "unified"}}}}}},
    {"if": {"properties": {"operation": {"enum": ["scalar_property_set", "item_properties_set"]}}}, "then": {"required": ["properties"], "properties": {"name": false, "dataType": false, "placement": false, "bindings": false, "connection": false, "plcTag": false}}},
    {"if": {"properties": {"operation": {"const": "scalar_property_set"}}}, "then": {"properties": {"properties": {"maxProperties": 1}}}},
    {"if": {"properties": {"operation": {"const": "item_place"}}}, "then": {"required": ["placement"], "properties": {"name": false, "dataType": false, "properties": false, "bindings": false, "connection": false, "plcTag": false}}},
    {"if": {"properties": {"operation": {"enum": ["existing_binding_set", "explicit_binding_set"]}}}, "then": {"required": ["bindings"], "properties": {"name": false, "dataType": false, "properties": false, "placement": false, "connection": false, "plcTag": false}}},
    {"if": {"properties": {"operation": {"const": "existing_binding_set"}}}, "then": {"properties": {"bindings": {"items": {"required": ["expectedValue"]}}}}}
  ]
}
