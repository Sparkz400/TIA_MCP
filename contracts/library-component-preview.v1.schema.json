                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4194304
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "sourceOracleExportOptions": {
                    "const": "WithDefaults, WithReadOnly"
                  },
                  "sourceOracleSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                  },
                  "sourceOriginalLibrary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  }
