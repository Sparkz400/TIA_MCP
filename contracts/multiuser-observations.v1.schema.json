              "maxLength": 2048,
              "pattern": "^(http|https|net\\.tcp)://(\\[[0-9a-fA-F:]+\\]|[^/:?#@\\s]+)/*$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
