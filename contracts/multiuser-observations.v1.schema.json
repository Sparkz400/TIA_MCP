        },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "diagnostic",
            "rows"
          ],
          "properties": {
            "coverage": {
              "enum": [
                "complete",
                "partial",
                "unknown",
                "denied",
                "failed",
                "unavailable"
              ]
            },
            "diagnostic": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/groupsRow"
              },
              "maxItems": 128
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "coverage": {
                    "enum": [
                      "unknown",
                      "denied",
                      "failed",
                      "unavailable"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "rows": {
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "coverage": {
                    "not": {
                      "const": "complete"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                }
              }
            }
          ]
        },
