{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multiuser-observations.v1.schema.json",
  "$ref": "#/$defs/request",
  "$defs": {
    "groupsRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "maxItems": 16
        }
      }
    },
    "projectsRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupPath",
        "name",
        "revision",
        "lock"
      ],
      "properties": {
        "groupPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "maxItems": 16
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "owner"
          ],
          "properties": {
            "state": {
              "enum": [
                "locked",
                "unlocked",
                "unknown"
              ]
            },
            "owner": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "locked"
                  }
                }
              },
              "then": {
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!\\s*$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                }
              },
              "else": {
                "properties": {
                  "owner": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },
