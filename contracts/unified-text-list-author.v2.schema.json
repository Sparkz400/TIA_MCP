        "status": {
          "enum": [
            "unavailableOrAmbiguous",
            "capturedDeclaration"
          ]
        },
        "dataType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeCompatibilityVerified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "bindingReview": {
      "type": "object",
      "required": [
        "id",
        "selection",
        "beforeDeclaration",
        "afterDeclaration",
        "change",
        "capturedProperty",
        "conflicts",
        "gaps",
        "nativeCompatibilityVerified",
        "runtimeStorageVerified"
