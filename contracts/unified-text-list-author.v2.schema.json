              "$ref": "#/$defs/member"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaredHmiType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "declaration": {
      "type": "object",
      "required": [
        "objectPath",
        "memberPath",
        "status",
        "dataType",
        "evidence",
        "nativeCompatibilityVerified"
      ],
      "properties": {
        "objectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "memberPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 16,
          "minItems": 1
