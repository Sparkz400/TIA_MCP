{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/unified-text-list-author.v2.schema.json",
  "$defs": {
    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "reviewId",
        "objectPaths"
      ],
      "properties": {
        "reviewId": {
          "$ref": "#/$defs/hash"
        },
        "objectPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": [
        "reviewId",
        "hmiPath",
