      "properties": {
        "objectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "memberPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "id",
        "outputId",
        "property",
        "beforeMember",
        "afterMember",
        "declaredHmiType",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outputId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
