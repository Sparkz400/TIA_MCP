      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "selection": {
          "$ref": "#/$defs/binding"
        },
        "beforeDeclaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/declaration"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterDeclaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/declaration"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "enum": [
            "added",
            "removed",
            "typeTextChanged",
            "explicitMemberMapping",
            "sameSelectedMember"
          ]
        },
        "capturedProperty": {},
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 32
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 32
        },
        "nativeCompatibilityVerified": {
          "const": false
        },
        "runtimeStorageVerified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "authorIntent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
