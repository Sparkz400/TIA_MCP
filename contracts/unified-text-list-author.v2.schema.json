                    "type": {
                      "enum": [
                        "SingleValue",
                        "Range",
                        "From",
                        "To"
                      ]
                    },
                    "fromValue": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    "toValue": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
