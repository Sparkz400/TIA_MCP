{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/diagnostic-runtime-acquisition.v1.schema.json",
  "title": "Exact retained sequential runtime acquisition for a diagnostic experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experimentId", "snapshotRef", "request", "experiment", "captureSource", "analysisId", "analysis", "acquisitionMode", "sourceEvidenceRevalidated", "qualityLimits", "completeCommittedPrefixRetained", "plcChangesBetweenPollsUnknown", "limits", "atomicAcrossSignals", "scanSynchronized", "programMatchVerified", "addressMatchVerified", "sourceAuthenticityVerified", "clockSynchronizationVerified", "assertionsAdmitted", "causationProven", "bugFixProven", "nativeQualification", "nativeAccessAttempted"],
  "properties": {
    "schemaVersion": {"const": "diagnostic-runtime-acquisition.v1"},
    "experimentId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
    "snapshotRef": {"$ref": "#/$defs/snapshot"},
    "request": {"$ref": "#/$defs/request"},
    "experiment": {"$ref": "diagnostic-experiment.v1.schema.json"},
    "captureSource": {"$ref": "#/$defs/source"},
    "analysisId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
    "analysis": {"$ref": "runtime-capture-analysis.v1.schema.json"},
    "acquisitionMode": {"const": "sequentialPolling"},
    "sourceEvidenceRevalidated": {"const": true},
    "qualityLimits": {"type": "array", "minItems": 3, "maxItems": 12, "items": {"type": "string"}},
    "completeCommittedPrefixRetained": {"const": true},
    "plcChangesBetweenPollsUnknown": {"const": true},
    "limits": {"type": "string", "minLength": 1},
    "atomicAcrossSignals": {"const": false},
    "scanSynchronized": {"const": false},
    "programMatchVerified": {"const": false},
    "addressMatchVerified": {"const": false},
    "sourceAuthenticityVerified": {"const": false},
    "clockSynchronizationVerified": {"const": false},
    "assertionsAdmitted": {"const": false},
    "causationProven": {"const": false},
    "bugFixProven": {"const": false},
    "nativeQualification": {"const": false},
    "nativeAccessAttempted": {"const": false}
  },
  "$defs": {
    "snapshot": {"type": "string", "pattern": "^capture:[a-f0-9]{32}:[0-9]{1,6}:[a-f0-9]{64}$"},
    "request": {
      "type": "object", "additionalProperties": false, "required": ["reason", "units"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "units": {"type": "object", "minProperties": 1, "maxProperties": 64, "propertyNames": {"minLength": 1, "maxLength": 64}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["experimentId", "snapshotRef", "request"],
      "properties": {
        "experimentId": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
        "snapshotRef": {"$ref": "#/$defs/snapshot"}, "request": {"$ref": "#/$defs/request"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotRef", "originalFiles", "originalByteCount", "plan", "recordedProgress", "rows", "rowsTruncated", "chainSha256", "planSha256", "segmentCount", "currentHeadConsulted", "uncommittedDataUnknown"],
      "properties": {
        "snapshotRef": {"$ref": "#/$defs/snapshot"},
        "originalFiles": {
          "type": "array", "minItems": 1, "maxItems": 100002,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["relativePath", "sha256", "bytes", "base64"],
            "properties": {
              "relativePath": {"type": "string", "pattern": "^runtime-captures/[a-f0-9]{32}/(plan\\.json|[0-9]{6}\\.segment)$"},
              "sha256": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
              "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
              "base64": {"type": "string", "minLength": 4, "maxLength": 1398104, "contentEncoding": "base64"}
            }
          }
        },
        "originalByteCount": {"type": "integer", "minimum": 1, "maximum": 3145728},
        "plan": {"$ref": "runtime-capture.v1.schema.json#/$defs/plan"},
        "recordedProgress": {"$ref": "runtime-capture.v1.schema.json#/$defs/progress"},
        "rows": {"type": "array", "maxItems": 10000, "items": {"$ref": "runtime-capture.v1.schema.json#/$defs/row"}},
        "rowsTruncated": {"const": false},
        "chainSha256": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
        "planSha256": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
        "segmentCount": {"type": "integer", "minimum": 0, "maximum": 100001},
        "currentHeadConsulted": {"const": false},
        "uncommittedDataUnknown": {"type": "boolean"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false, "required": ["id", "artifact", "schemaVersion", "acquisition"],
      "properties": {
        "id": {"$ref": "diagnostic-case.v1.schema.json#/$defs/hash"},
        "artifact": {"$ref": "diagnostic-experiment.v1.schema.json#/$defs/artifact"},
        "schemaVersion": {"const": "diagnostic-runtime-acquisition.v1"},
        "acquisition": {"$ref": "#"}
      }
    }
  }
}
