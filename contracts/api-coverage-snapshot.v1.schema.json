{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/api-coverage-snapshot.v1.schema.json",
  "title": "Offline public API coverage snapshot, first AC-01 slice",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "observedAtUtc", "apiRoot", "nativeExecuted", "targetProbed", "releaseAccepted", "semanticSha256", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "api-coverage-offline-snapshot"},
    "observedAtUtc": {"type": "string", "format": "date-time"},
    "apiRoot": {"type": "string", "minLength": 1},
    "nativeExecuted": {"const": false},
    "targetProbed": {"const": false},
    "releaseAccepted": {"const": false},
    "semanticSha256": {"$ref": "#/$defs/digest"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "symbols", "schemas", "metadataUnresolved", "discrepancies", "registry", "features", "retainedEvidence", "sourceInputs", "registrySha256", "metadataSemanticSha256", "residuals"],
      "properties": {
        "files": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/input"}},
        "sourceInputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}},
        "schemas": {"type": "array", "items": {"type": "object", "required": ["path", "namespace", "dependencies", "leaves"]}},
        "metadataUnresolved": {"type": "array", "items": {"type": "object", "required": ["assembly", "items"]}},
        "discrepancies": {"type": "array", "items": {"type": "object", "required": ["assembly", "id", "presence", "review"], "properties": {"presence": {"enum": ["xml_only", "dll_only"]}, "review": {"const": "unresolved"}}}},
        "registry": {"$ref": "api-coverage-registry.v1.schema.json"},
        "features": {"type": "array", "items": {"type": "object", "required": ["featureId", "catalogRecord", "registrations", "dispatchCandidates", "schemaBindings", "mappingReview", "releaseAccepted"], "properties": {"releaseAccepted": {"const": false}, "mappingReview": {"const": "handler_and_schema_review_required"}}}},
        "retainedEvidence": {"type": "array", "items": {"type": "object"}},
        "registrySha256": {"$ref": "#/$defs/digest"},
        "metadataSemanticSha256": {"$ref": "#/$defs/digest"},
        "residuals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["assembly", "id", "presence", "xml", "metadata", "classification"],
      "properties": {
        "assembly": {"type": "string", "minLength": 1}, "id": {"type": "string", "pattern": "^[TMPFE]:.+"},
        "presence": {"enum": ["both", "xml_only", "dll_only"]},
        "xml": {"type": ["object", "null"]}, "metadata": {"type": ["object", "null"]},
        "classification": {"enum": ["semantic", "infrastructure", "untriaged"]},
        "operationId": {"type": "string"}, "reason": {"type": "string"}
      }
    }
  }
}
