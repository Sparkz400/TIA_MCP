{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/testsuite-run.v1.schema.json",
  "title": "Pure Test Suite run plan; resource admission is separate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planSha256",
    "executionMode",
    "dispatchDefinitionIds",
    "requiredDefinitionIds",
    "excludedDefinitionIds",
    "definitions",
    "blockers",
    "nativeExecutionAuthorized"
  ],
  "properties": {
    "planSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionMode": {
      "enum": [
        "style",
        "systemManaged",
        "externallyManaged",
        "endpoint"
      ]
    },
    "dispatchDefinitionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "requiredDefinitionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "excludedDefinitionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "testsuite-definition.v1.schema.json"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "nativeExecutionAuthorized": {
      "const": false
    }
  }
}
