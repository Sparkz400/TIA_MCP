{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/protected-credential.v1.schema.json",
  "title": "Local protected credential public contracts; no plaintext or external authentication claim",
  "$ref": "#/$defs/status",
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "externalSelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "authority",
        "ownerId",
        "resourceKind",
        "resourceId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/externalSelector"
        },
        "authority": {
          "$ref": "#/$defs/externalSelector"
        },
        "ownerId": {
          "$ref": "#/$defs/externalSelector"
        },
        "resourceKind": {
          "$ref": "#/$defs/externalSelector"
        },
        "resourceId": {
          "$ref": "#/$defs/externalSelector"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "purpose",
        "subjectId"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/identity"
        },
        "purpose": {
          "$ref": "#/$defs/externalSelector"
        },
        "subjectId": {
          "$ref": "#/$defs/externalSelector"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "vaultId",
        "credentialId",
        "bindingSha256",
        "cipherSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "protected-credential-reference.v1"
        },
        "vaultId": {
          "$ref": "#/$defs/id"
        },
        "credentialId": {
          "$ref": "#/$defs/id"
        },
        "bindingSha256": {
          "$ref": "#/$defs/digest"
        },
        "cipherSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "binding",
        "state",
        "decryptionVerified",
        "protection",
        "secretReturned"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "state": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "decryptionVerified": {
          "type": "boolean"
        },
        "protection": {
          "const": "Windows DPAPI CurrentUser"
        },
        "secretReturned": {
          "const": false
        },
        "operationReferences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operationReference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "retired"
              }
            }
          },
          "then": {
            "properties": {
              "decryptionVerified": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "list": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/status"
      }
    },
    "operationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRoot",
        "operationId",
        "planSha256"
      ],
      "properties": {
        "artifactRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "operationId": {
          "$ref": "#/$defs/id"
        },
        "planSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
