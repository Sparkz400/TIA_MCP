{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/runtime-web-session.v1.schema.json",
  "title": "Owned Web API session observation; physical identity remains unverified",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "hostId",
    "context",
    "login",
    "state",
    "errorCode",
    "peerVerified",
    "methods",
    "readAvailability",
    "trust",
    "deviceIdentityVerified",
    "programMatchVerified",
    "nativeQualified",
    "secretReturned"
  ],
  "properties": {
    "schemaVersion": {
      "const": "runtime-web-session.v1"
    },
    "attemptId": {
      "$ref": "https://tia-mcp.local/contracts/physical-runtime.v1.schema.json#/$defs/id"
    },
    "hostId": {
      "$ref": "https://tia-mcp.local/contracts/physical-runtime.v1.schema.json#/$defs/id"
    },
    "context": {
      "$ref": "https://tia-mcp.local/contracts/physical-runtime.v1.schema.json#/$defs/context"
    },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "peerCertificateSha256",
        "user",
        "mode",
        "vaultName",
        "credential"
      ],
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "peerCertificateSha256": {
          "$ref": "https://tia-mcp.local/contracts/physical-runtime.v1.schema.json#/$defs/sha256"
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "mode": {
          "enum": [
            "local",
            "static",
            "disabled",
            "umc"
          ]
        },
        "vaultName": {
          "type": "string"
        },
        "credential": {
          "$ref": "https://tia-mcp.local/contracts/protected-credential.v1.schema.json#/$defs/reference"
        }
      }
    },
    "state": {
      "enum": [
        "connecting",
        "connected",
        "disconnecting",
        "closed",
        "notConnected",
        "remoteSessionUnknown",
        "hostEndedRemoteUnknown",
        "abandonedRemoteUnknown"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "peerVerified": {
      "type": "boolean"
    },
    "methods": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "readAvailability": {
      "enum": [
        "unsupported",
        "permissionUnknown",
        "permissionDenied",
        "permittedAtObservation"
      ]
    },
    "trust": {
      "const": "explicitLeafPinAndHostnameAndValidity"
    },
    "deviceIdentityVerified": {
      "const": false
    },
    "programMatchVerified": {
      "const": false
    },
    "nativeQualified": {
      "const": false
    },
    "secretReturned": {
      "const": false
    }
  }
}
