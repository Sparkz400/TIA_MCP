{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/composite-engineering-review.v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "composite-engineering-review.v1"
    },
    "contexts": {
      "type": "object",
      "properties": {
        "before": {
          "type": "object",
          "properties": {
            "reviewId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "projectDeclaration": {
              "type": "object"
            },
            "automationMlRef": {
              "type": "string",
              "pattern": "^automationml:[a-f0-9]{32}:[a-f0-9]{64}$"
            },
            "automationMlSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "maxItems": 64
            },
            "drives": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "maxItems": 64
            },
            "technology": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "maxItems": 64
            },
            "components": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "connection",
                      "drive",
                      "technology"
                    ]
                  },
                  "recordRef": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "schemaVersion": {
                    "type": "string"
                  },
                  "afterKind": {
                    "enum": [
                      "observation",
                      "proposal"
                    ]
                  },
                  "summary": {
                    "type": "object"
                  },
                  "coverage": {
                    "type": "object"
                  },
                  "limits": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "recordRef",
                  "schemaVersion",
                  "afterKind",
                  "summary",
                  "coverage",
                  "limits"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "reviewId",
            "projectDeclaration",
            "automationMlRef",
            "automationMlSha256",
            "connections",
            "drives",
            "technology",
            "components"
          ],
          "additionalProperties": false
        },
        "after": {
          "type": "object",
          "properties": {
            "reviewId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "projectDeclaration": {
              "type": "object"
            },
            "automationMlRef": {
              "type": "string",
              "pattern": "^automationml:[a-f0-9]{32}:[a-f0-9]{64}$"
            },
            "automationMlSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "maxItems": 64
            },
            "drives": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "maxItems": 64
            },
            "technology": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "maxItems": 64
            },
            "components": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "connection",
                      "drive",
                      "technology"
                    ]
                  },
                  "recordRef": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "schemaVersion": {
                    "type": "string"
                  },
                  "afterKind": {
                    "enum": [
                      "observation",
                      "proposal"
                    ]
                  },
                  "summary": {
                    "type": "object"
                  },
                  "coverage": {
                    "type": "object"
                  },
                  "limits": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "recordRef",
                  "schemaVersion",
                  "afterKind",
                  "summary",
                  "coverage",
                  "limits"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "reviewId",
            "projectDeclaration",
            "automationMlRef",
            "automationMlSha256",
            "connections",
            "drives",
            "technology",
            "components"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "selector": {
            "$ref": "#/$defs/selector"
          },
          "state": {
            "enum": [
              "resolvedDeclaration",
              "ambiguous",
              "unresolved",
              "selectorMismatch",
              "disconnected"
            ]
          },
          "evidence": {
            "type": [
              "object",
              "null"
            ]
          },
          "profile": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "selector",
          "state",
          "evidence",
          "profile"
        ],
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mapping": {
            "$ref": "#/$defs/mapping"
          },
          "state": {
            "enum": [
              "declaredAssociation",
              "unresolvedSelection",
              "unsupportedSemantics"
            ]
          },
          "sourceState": {
            "enum": [
              "resolvedDeclaration",
              "ambiguous",
              "unresolved",
              "selectorMismatch",
              "disconnected"
            ]
          },
          "targetState": {
            "enum": [
              "resolvedDeclaration",
              "ambiguous",
              "unresolved",
              "selectorMismatch",
              "disconnected"
            ]
          },
          "nativeVerified": {
            "const": false
          }
        },
        "required": [
          "mapping",
          "state",
          "sourceState",
          "targetState",
          "nativeVerified"
        ],
        "additionalProperties": false
      }
    },
    "correspondences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "correspondence": {
            "$ref": "#/$defs/correspondence"
          },
          "state": {
            "enum": [
              "unresolvedSelection",
              "crossCopyDeclaration",
              "profileMismatch",
              "declaredCorrespondence"
            ]
          },
          "profileChanged": {
            "type": "boolean"
          },
          "beforeState": {
            "enum": [
              "resolvedDeclaration",
              "ambiguous",
              "unresolved",
              "selectorMismatch",
              "disconnected"
            ]
          },
          "afterState": {
            "enum": [
              "resolvedDeclaration",
              "ambiguous",
              "unresolved",
              "selectorMismatch",
              "disconnected"
            ]
          },
          "identityEqualityVerified": {
            "const": false
          }
        },
        "required": [
          "correspondence",
          "state",
          "profileChanged",
          "beforeState",
          "afterState",
          "identityEqualityVerified"
        ],
        "additionalProperties": false
      }
    },
    "amlComparison": {
      "type": "object"
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "enum": [
              "before",
              "after"
            ]
          },
          "amlImpact": {
            "type": "object"
          },
          "state": {
            "enum": [
              "unmapped",
              "declaredMappedImpact"
            ]
          },
          "destinationKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "declaredCycle": {
            "type": "boolean"
          },
          "traversalExhausted": {
            "type": "boolean"
          },
          "nativeImpactVerified": {
            "const": false
          }
        },
        "required": [
          "phase",
          "amlImpact",
          "state",
          "destinationKeys",
          "declaredCycle",
          "traversalExhausted",
          "nativeImpactVerified"
        ],
        "additionalProperties": false
      }
    },
    "coverageGaps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "conflictingAssignment"
              },
              "targetKey": {
                "type": "string"
              },
              "sourceKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "targetKey",
              "sourceKeys"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "crossCopyDeclaration",
                  "wholeDocumentReviewRequired",
                  "declaredMappingGraphOnly"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "nativeExecutable": {
      "const": false
    },
    "nativeQualified": {
      "const": false
    },
    "sourceAuthenticityVerified": {
      "const": false
    },
    "liveFreshnessVerified": {
      "const": false
    },
    "wholeImpactAnalysisComplete": {
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "contexts",
    "selections",
    "mappings",
    "correspondences",
    "amlComparison",
    "impacts",
    "coverageGaps",
    "nativeExecutable",
    "nativeQualified",
    "sourceAuthenticityVerified",
    "liveFreshnessVerified",
    "wholeImpactAnalysisComplete"
  ],
  "additionalProperties": false,
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "amlObject"
            },
            "phase": {
              "enum": [
                "before",
                "after"
              ]
            },
            "recordRef": {
              "type": "string",
              "pattern": "^automationml:[a-f0-9]{32}:[a-f0-9]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "required": [
            "kind",
            "phase",
            "recordRef",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "amlAttribute"
            },
            "phase": {
              "enum": [
                "before",
                "after"
              ]
            },
            "recordRef": {
              "type": "string",
              "pattern": "^automationml:[a-f0-9]{32}:[a-f0-9]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "required": [
            "kind",
            "phase",
            "recordRef",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "amlLink"
            },
            "phase": {
              "enum": [
                "before",
                "after"
              ]
            },
            "recordRef": {
              "type": "string",
              "pattern": "^automationml:[a-f0-9]{32}:[a-f0-9]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "required": [
            "kind",
            "phase",
            "recordRef",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "model"
            },
            "phase": {
              "enum": [
                "before",
                "after"
              ]
            },
            "reviewId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "objectPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "required": [
            "kind",
            "phase",
            "reviewId",
            "nodeId",
            "objectPath"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "connectionEndpoint"
            },
            "phase": {
              "enum": [
                "before",
                "after"
              ]
            },
            "recordRef": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "endpoint": {
              "enum": [
                "local",
                "partner"
              ]
            }
          },
          "required": [
            "kind",
            "phase",
            "recordRef",
            "id",
            "endpoint"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "driveParameter"
            },
            "phase": {
              "enum": [
                "before",
                "after"
              ]
            },
            "recordRef": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "number": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "arrayIndex": {
              "type": "integer",
              "minimum": -1,
              "maximum": 32767
            }
          },
          "required": [
            "kind",
            "phase",
            "recordRef",
            "name",
            "number",
            "arrayIndex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "technologyRelationship"
            },
            "phase": {
              "enum": [
                "before",
                "after"
              ]
            },
            "recordRef": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "required": [
            "kind",
            "phase",
            "recordRef",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mapping": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "phase": {
          "enum": [
            "before",
            "after"
          ]
        },
        "purpose": {
          "enum": [
            "hardware",
            "communication",
            "parameter",
            "dependent",
            "telegram",
            "encoder"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "source": {
          "$ref": "#/$defs/selector"
        },
        "target": {
          "$ref": "#/$defs/selector"
        }
      },
      "required": [
        "id",
        "phase",
        "purpose",
        "reason",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "correspondence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "kind": {
          "enum": [
            "continuity",
            "replacement"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "before": {
          "$ref": "#/$defs/selector"
        },
        "after": {
          "$ref": "#/$defs/selector"
        }
      },
      "required": [
        "id",
        "kind",
        "reason",
        "before",
        "after"
      ],
      "additionalProperties": false
    }
  }
}
