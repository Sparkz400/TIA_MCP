{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tia-mcp.local/contracts/plc-library-integration-recipe.v1.schema.json",
  "title": "Plan-only PLC component integration recipe",
  "description": "Payload for change_prepare(kind=library_integrate). This plans separate existing operations; it cannot authorize or execute combined installation. Exact dependency closure, unique native tag names, parameter directions/types, collisions, standard scope, protection and native caller identity are checked from actual observations. scopePath, when supplied, must equal plcPath. All native qualification remains separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "planOnly",
    "source",
    "selection",
    "target",
    "integration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "action": {
      "const": "plc_component_plan"
    },
    "planOnly": {
      "const": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libraryId",
        "revision"
      ],
      "properties": {
        "libraryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectName",
        "plcPath"
      ],
      "properties": {
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "plcPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "scopePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyPins",
        "instanceDb",
        "caller",
        "mappings"
      ],
      "properties": {
        "dependencyPins": {
          "type": "array",
          "minItems": 0,
          "maxItems": 999,
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "instanceDb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "numberPolicy"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}(?![\\s\\S])"
            },
            "numberPolicy": {
              "const": "firstAvailable"
            }
          }
        },
        "caller": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blockPath",
                "insertAfterNetworkId"
              ],
              "properties": {
                "blockPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "insertAfterNetworkId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[0-9A-Fa-f]+(?![\\s\\S])"
                },
                "mode": {
                  "const": "existing"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "name",
                "language",
                "numberPolicy"
              ],
              "properties": {
                "mode": {
                  "const": "createStandaloneFc"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}(?![\\s\\S])"
                },
                "language": {
                  "enum": [
                    "LAD",
                    "FBD"
                  ]
                },
                "numberPolicy": {
                  "const": "firstAvailable"
                }
              }
            }
          ]
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "direction",
              "dataType",
              "tagPath"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}(?![\\s\\S])"
              },
              "direction": {
                "enum": [
                  "Input",
                  "Output",
                  "InOut"
                ]
              },
              "dataType": {
                "enum": [
                  "Bool",
                  "Byte",
                  "Word",
                  "DWord",
                  "LWord",
                  "SInt",
                  "USInt",
                  "Int",
                  "UInt",
                  "DInt",
                  "UDInt",
                  "LInt",
                  "ULInt",
                  "Real",
                  "LReal",
                  "Time",
                  "LTime"
                ]
              },
              "tagPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeGuid",
        "versionGuid"
      ],
      "properties": {
        "typeGuid": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
        },
        "versionGuid": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
        }
      }
    }
  }
}
