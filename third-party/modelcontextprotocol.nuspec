<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ModelContextProtocol</id>
    <version>2.2.0</version>
    <authors>ModelContextProtocol</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://csharp.sdk.modelcontextprotocol.io/</projectUrl>
    <description>.NET SDK for the Model Context Protocol (MCP) with hosting and dependency injection extensions.</description>
    <copyright>© Model Context Protocol a Series of LF Projects, LLC.</copyright>
    <tags>ModelContextProtocol mcp ai llm</tags>
    <repository type="git" url="https://github.com/modelcontextprotocol/csharp-sdk" commit="6fa3825973949a9c4f0cd8af344e15a8db09dc35" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="ModelContextProtocol.Core" version="[2.2.0]" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="ModelContextProtocol.Core" version="[2.2.0]" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="ModelContextProtocol.Core" version="[2.2.0]" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="ModelContextProtocol.Core" version="[2.2.0]" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.10" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>