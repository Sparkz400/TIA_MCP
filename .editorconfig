root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,js,cjs,mjs,html,css,xml,xsd,csproj,props,targets,config,slnx}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Preserve byte-sensitive test inputs and upstream formatting when opening files.
[{fixtures,third-party}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
