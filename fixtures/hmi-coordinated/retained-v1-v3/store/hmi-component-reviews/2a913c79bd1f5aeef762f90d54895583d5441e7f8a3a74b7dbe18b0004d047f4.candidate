#Version: 2.0
TextLibraries:
  "StateLibrary":
    Type: Text
    Languages:
      - "de-DE"
      - "en-US"
    DefaultLanguage: "de-DE"
    Entries:
      "Idle":
        Text:
          - "Idle Deutsch"
          - "Stopped 😀\u000aNo native execution"
      "Active":
        Text:
          - "Active Deutsch"
          - "Active"
