#Version: 2.0
TextLibraries:
  "RunTexts":
    Type: Text
    Languages:
      - "de-DE"
      - "en-US"
    DefaultLanguage: "de-DE"
    Entries:
      "FalseText":
        Text:
          - "Gestoppt"
          - "Stopped"
      "TrueText":
        Text:
          - "Läuft"
          - "Running 😀\u000aExplicit supplied output"
