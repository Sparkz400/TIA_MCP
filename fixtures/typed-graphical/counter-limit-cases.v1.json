      "runtimeSources": [
        {
          "language": "SCL",
          "source": "FUNCTION_BLOCK \"Tgp_CTU_LimitDriver_LAD\"\n{ S7_Optimized_Access := 'TRUE' }\nVAR_INPUT\n    Edges : Int;\n    Reset : Bool;\nEND_VAR\nVAR_OUTPUT\n    Count : Int;\n    Done : Bool;\n    Rejected : Bool;\nEND_VAR\nVAR\n    Counter : \"Tgp_CTU_LAD\";\nEND_VAR\nVAR_TEMP\n    Index : Int;\nEND_VAR\nBEGIN\n    #Rejected := (#Edges < 0) OR (#Edges > 512);\n    IF NOT #Rejected THEN\n        IF #Reset OR (#Edges = 0) THEN\n            #Counter(Enable := FALSE, Down := FALSE, Reset := #Reset,\n                     Load := FALSE, Preset := 32767,\n                     Done => #Done, Count => #Count);\n        ELSE\n            FOR #Index := 1 TO #Edges DO\n                #Counter(Enable := FALSE, Down := FALSE, Reset := FALSE,\n                         Load := FALSE, Preset := 32767,\n                         Done => #Done, Count => #Count);\n                #Counter(Enable := TRUE, Down := FALSE, Reset := FALSE,\n                         Load := FALSE, Preset := 32767,\n                         Done => #Done, Count => #Count);\n            END_FOR;\n        END_IF;\n    END_IF;\nEND_FUNCTION_BLOCK\n",
