{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "LAD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_CTD_Global_LAD"
VAR_INPUT
  Enable : Bool;
  Down : Bool;
  Reset : Bool;
  Load : Bool;
  Preset : Int;
END_VAR
VAR_OUTPUT
  Done : Bool;
  Lower : Bool;
  Count : Int;
END_VAR
{ S7_Language := "LAD" }
NETWORK
RUNG wire#powerrail
  Contact( #Enable )
  { S7_Templates := "value_type := Int" }
  "Tgp_GlobalCounter".CTD( ld := #Load, pv := #Preset, cv => #Count )
  Coil( #Done )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK
