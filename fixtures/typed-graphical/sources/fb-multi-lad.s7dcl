{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "LAD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_FB_multi_LAD"
VAR_INPUT
  Enable : Bool;
END_VAR
VAR_OUTPUT
  Active : Bool;
END_VAR
VAR
  Child : "TiaMcp_EnableGate";
END_VAR
{ S7_Language := "LAD" }
NETWORK
RUNG wire#powerrail
  #Child( Enable := #Enable, Active => #Active )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK
