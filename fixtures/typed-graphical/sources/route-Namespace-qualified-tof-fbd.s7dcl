NAMESPACE TiaMcp_UnitA.Alternate
{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "FBD"; S7_Version := "0.1" }
FUNCTION_BLOCK "TgpNamespace_TOF_FBD"
VAR_INPUT
  Enable : Bool;
  Preset : Time;
END_VAR
VAR_OUTPUT
  Done : Bool;
  Elapsed : Time;
END_VAR
VAR
  Storage : TOF_TIME;
END_VAR
{ S7_Language := "FBD" }
NETWORK
RUNG
  #Enable
  { S7_Templates := "time_type := Time" }
  #Storage.TOF( pt := #Preset, et => #Elapsed )
  Coil( #Done )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK

END_NAMESPACE
