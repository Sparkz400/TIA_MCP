{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "LAD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_MulInt_LAD"
VAR_INPUT
  Left : Int;
  Right : Int;
END_VAR
VAR_OUTPUT
  Result : Int;
END_VAR
{ S7_Language := "LAD" }
NETWORK
RUNG wire#powerrail
  { S7_Templates := "SrcType := Int" }
  Mul( in1 := #Left, in2 := #Right, out => #Result )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK
