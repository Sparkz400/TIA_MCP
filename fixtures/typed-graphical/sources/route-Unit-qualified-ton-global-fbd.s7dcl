NAMESPACE TiaMcp_UnitA
{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "FBD"; S7_Version := "0.1" }
FUNCTION_BLOCK "TgpUnit_TON_Global_FBD"
VAR_INPUT
  Enable : Bool;
  Preset : Time;
END_VAR
VAR_OUTPUT
  Done : Bool;
  Elapsed : Time;
END_VAR
{ S7_Language := "FBD" }
NETWORK
RUNG
  #Enable
  { S7_Templates := "time_type := Time" }
  "TiaMcp_UnitA.TgpUnit_GlobalTimer".TON( pt := #Preset, et => #Elapsed )
  Coil( #Done )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK

END_NAMESPACE
