{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "LAD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_MoveInt_LAD"
VAR_INPUT
  Source : Int;
END_VAR
VAR_OUTPUT
  Target : Int;
END_VAR
{ S7_Language := "LAD" }
NETWORK
RUNG wire#powerrail
  Move( in := #Source, out1 => #Target )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK
