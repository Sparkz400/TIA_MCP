NAMESPACE TiaMcp_UnitA.Alternate
{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "LAD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_Namespace_LAD"
VAR_INPUT
  A : Bool;
  B : Bool;
  Inhibit : Bool;
END_VAR
VAR_OUTPUT
  Active : Bool;
END_VAR
{ S7_Language := "LAD" }
NETWORK
RUNG wire#powerrail
  Contact( #A )
  wire#joined
  I_Contact( #Inhibit )
  Coil( #Active )
END_RUNG
RUNG wire#powerrail
  Contact( #B )
END_RUNG wire#joined
END_NETWORK
END_FUNCTION_BLOCK
END_NAMESPACE
