NAMESPACE TiaMcp_UnitA
{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "FBD"; S7_Version := "0.1" }
FUNCTION_BLOCK "TgpUnit_And_FBD"
VAR_INPUT
 A : Bool;
 B : Bool;
END_VAR
VAR_OUTPUT
 Active : Bool;
END_VAR
{ S7_Language := "FBD" }
NETWORK
RUNG
 #A
 A( in2 := #B )
 Coil( #Active )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK
END_NAMESPACE
