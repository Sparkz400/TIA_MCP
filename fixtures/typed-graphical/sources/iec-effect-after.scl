FUNCTION_BLOCK "Tgp_IecEffect"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
 Enable : Bool;
END_VAR
VAR_OUTPUT
 Active : Bool;
END_VAR
VAR
 RetainedMarker : Int := 17;
 Timer_TON : TON_TIME;
 Timer_TOF : TOF_TIME;
 Timer_TP : TP_TIME;
 Counter_CTU : CTU_INT;
 Counter_CTD : CTD_INT;
 Counter_CTUD : CTUD_INT;
 Timer_TONR : TONR_TIME;
 Edge_RTRIG : R_TRIG;
 Edge_FTRIG : F_TRIG;
END_VAR
BEGIN
 #Active := #Enable;
END_FUNCTION_BLOCK
