{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "LAD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_GeReal_LAD"
VAR_INPUT
  Left : Real;
  Right : Real;
END_VAR
VAR_OUTPUT
  Result : Bool;
END_VAR
{ S7_Language := "LAD" }
NETWORK
RUNG wire#powerrail
  { S7_Templates := "SrcType := Real" }
  Ge( in1 := #Left, in2 := #Right )
  Coil( #Result )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK
