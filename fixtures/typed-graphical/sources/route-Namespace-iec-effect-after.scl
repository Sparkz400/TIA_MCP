NAMESPACE TiaMcp_UnitA.Alternate
FUNCTION_BLOCK "TgpNamespace_IecEffect"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
 Enable : Bool;
END_VAR
VAR_OUTPUT
 Active : Bool;
END_VAR
VAR
 RetainedMarker : Int := 17;
 Timer_TON : TON_TIME;
 Timer_TOF : TOF_TIME;
 Timer_TP : TP_TIME;
 Counter_CTU : CTU_INT;
 Counter_CTD : CTD_INT;
 Counter_CTUD : CTUD_INT;
END_VAR
BEGIN
 #Active := #Enable;
END_FUNCTION_BLOCK

END_NAMESPACE
