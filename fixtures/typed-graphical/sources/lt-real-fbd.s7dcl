{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "FBD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_LtReal_FBD"
VAR_INPUT
  Left : Real;
  Right : Real;
END_VAR
VAR_OUTPUT
  Result : Bool;
END_VAR
{ S7_Language := "FBD" }
NETWORK
RUNG
  { S7_Templates := "SrcType := Real" }
