{ S7_Optimized := "TRUE"; S7_PreferredLanguage := "FBD"; S7_Version := "0.1" }
FUNCTION_BLOCK "Tgp_CTUD_Global_FBD"
VAR_INPUT
  Enable : Bool;
  Down : Bool;
  Reset : Bool;
  Load : Bool;
  Preset : Int;
END_VAR
VAR_OUTPUT
  Done : Bool;
  Lower : Bool;
  Count : Int;
END_VAR
{ S7_Language := "FBD" }
NETWORK
RUNG
  #Enable
  { S7_Templates := "value_type := Int" }
  "Tgp_GlobalCounter".CTUD( cd := #Down, r := #Reset, ld := #Load, pv := #Preset, qd => #Lower, cv => #Count )
  Coil( #Done )
END_RUNG
END_NETWORK
END_FUNCTION_BLOCK
