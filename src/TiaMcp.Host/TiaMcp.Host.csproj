<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(TestSuiteQualification)' == 'true'">$(DefineConstants);TESTSUITE_QUALIFICATION</DefineConstants>
    <DefineConstants Condition="'$(SafetyFParameterDiscovery)' == 'true'">$(DefineConstants);SAFETY_FPARAMETER_DISCOVERY</DefineConstants>
    <DefineConstants Condition="'$(OfflinePackage)' == 'true'">$(DefineConstants);OFFLINE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Advertised as MCP output schemas by ToolSurface. -->
    <!-- Every contract: output schemas of the tools, and the tia://contracts/{name} and tia://change-payloads resources. -->
    <EmbeddedResource Include="../../contracts/*.schema.json" LogicalName="TiaMcp.Contracts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TiaMcp.Inventory.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <ProjectReference Include="..\TiaMcp.Core\TiaMcp.Core.csproj" />
    <ProjectReference Include="..\TiaMcp.Translations\TiaMcp.Translations.csproj" />
    <ProjectReference Include="..\TiaMcp.OpcUa\TiaMcp.OpcUa.csproj" />
    <ProjectReference Include="..\TiaMcp.OpcUa.Runtime\TiaMcp.OpcUa.Runtime.csproj" />
  </ItemGroup>
</Project>
