<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(TestSuiteQualification)' == 'true'">$(DefineConstants);TESTSUITE_QUALIFICATION</DefineConstants>
    <DefineConstants Condition="'$(OfflinePackage)' == 'true'">$(DefineConstants);OFFLINE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <ProjectReference Include="..\TiaMcp.Core\TiaMcp.Core.csproj" />
    <ProjectReference Include="..\TiaMcp.Translations\TiaMcp.Translations.csproj" />
    <ProjectReference Include="..\TiaMcp.OpcUa\TiaMcp.OpcUa.csproj" />
    <ProjectReference Include="..\TiaMcp.OpcUa.Runtime\TiaMcp.OpcUa.Runtime.csproj" />
  </ItemGroup>
</Project>
