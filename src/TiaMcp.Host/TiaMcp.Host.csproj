<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(TestSuiteQualification)' == 'true'">$(DefineConstants);TESTSUITE_QUALIFICATION</DefineConstants>
    <DefineConstants Condition="'$(OfflinePackage)' == 'true'">$(DefineConstants);OFFLINE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Advertised as MCP output schemas by ToolSurface. -->
    <EmbeddedResource Include="../../contracts/automationml-workflow.v1.schema.json;../../contracts/graph-workflow.v1.schema.json;../../contracts/opc-ua-workflow.v1.schema.json;../../contracts/project-review-import.v1.schema.json;../../contracts/vci-workspace.v1.schema.json" LogicalName="TiaMcp.Contracts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TiaMcp.Inventory.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <ProjectReference Include="..\TiaMcp.Core\TiaMcp.Core.csproj" />
    <ProjectReference Include="..\TiaMcp.Translations\TiaMcp.Translations.csproj" />
    <ProjectReference Include="..\TiaMcp.OpcUa\TiaMcp.OpcUa.csproj" />
    <ProjectReference Include="..\TiaMcp.OpcUa.Runtime\TiaMcp.OpcUa.Runtime.csproj" />
  </ItemGroup>
</Project>
