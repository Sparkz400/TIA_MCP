<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <!-- The enrolled assembly identity is the deterministic module version ID. -->
    <Deterministic>true</Deterministic>
    <TiaApiDirectory Condition="'$(TiaApiDirectory)' == ''">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaApiDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Add-In reports the hash of these exact bytes; Publish-AddIn.ps1 publishes and enrolls the same file. -->
    <EmbeddedResource Include="AddIn.Publisher.xml" LogicalName="TiaMcp.AddIn.Publisher.xml" />
    <None Include="AddIn.Publisher.xml" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Siemens.Engineering.AddIn.Base"><HintPath>$(TiaApiDirectory)\Siemens.Engineering.AddIn.Base.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Siemens.Engineering.Base"><HintPath>$(TiaApiDirectory)\Siemens.Engineering.Base.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Siemens.Engineering.Step7"><HintPath>$(TiaApiDirectory)\Siemens.Engineering.Step7.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckTiaApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TiaApiDirectory)\Siemens.Engineering.AddIn.Base.dll')" Text="TIA V21 Add-In API is required. Set TiaApiDirectory to the installed PublicAPI\V21\net48 directory. Siemens assemblies are never bundled." />
  </Target>
</Project>
