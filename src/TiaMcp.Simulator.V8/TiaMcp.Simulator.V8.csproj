<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <SimulatorApiDirectory Condition="'$(SimulatorApiDirectory)' == ''">C:\Program Files (x86)\Common Files\Siemens\PLCSIMADV\API\8.0</SimulatorApiDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../TiaMcp.Core/WorkerPipeWriter.cs" Link="WorkerPipeWriter.cs" />
    <Compile Include="../TiaMcp.Core/JournalFileReplacement.cs" Link="JournalFileReplacement.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="System.Security" />
    <Reference Include="Siemens.Simatic.Simulation.Runtime.Api.x64">
      <HintPath>$(SimulatorApiDirectory)\Siemens.Simatic.Simulation.Runtime.Api.x64.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckSimulatorApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SimulatorApiDirectory)\Siemens.Simatic.Simulation.Runtime.Api.x64.dll')" Text="Installed PLCSIM Advanced V8 x64 API is required; set SimulatorApiDirectory. Vendor DLLs are not redistributed." />
  </Target>
</Project>
