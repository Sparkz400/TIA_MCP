<Project>
  <PropertyGroup>
    <!-- The one product version (pre-1.0 SemVer): every assembly, serverInfo, npm metadata and release bundles.
         scripts/test_product_version.py keeps the copies that cannot read it in step. -->
    <Version>0.9.0</Version>
    <!-- Report exactly this version, without a +commit suffix, so serverInfo and bundle manifests match it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <Authors>Nico Schürmann</Authors>
    <Copyright>Copyright 2026 Nico Schürmann</Copyright>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <RestoreFallbackFolders Condition="Exists('$(USERPROFILE)\.nuget\packages')">$(USERPROFILE)\.nuget\packages</RestoreFallbackFolders>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <Deterministic>true</Deterministic>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <!-- Analyzer rules with no finding today are errors (src/TiaMcp.Analyzers.globalconfig); every other rule keeps the
       SDK default for its AnalysisLevel. Items are evaluated after every property, so the project's own TargetFramework
       is known here. The net48 workers stay out: Test-WorkerCompile.ps1 reads their compiler errors. The file lives
       under src/ so isolated package builds (New-IsolatedBuild.ps1) copy it. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48' and Exists('$(MSBuildThisFileDirectory)src/TiaMcp.Analyzers.globalconfig')">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)src/TiaMcp.Analyzers.globalconfig" />
  </ItemGroup>
</Project>
